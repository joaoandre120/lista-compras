rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Texto opcional: ausente/nulo ou texto válido.
    function validOptionalText(value, max) {
      return value == null || validText(value, max);
    }

    // Data opcional no formato AAAA-MM-DD.
    function validOptionalDate(value) {
      return value == null
          || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // Campos que mudaram entre o documento atual e o enviado.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Cada get() abaixo conta como 1 leitura na cota.
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).memberIds;
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId)
          && groupData(groupId).roles[request.auth.uid] == 'admin';
    }

    // Lista privada: só o dono. Lista de grupo: qualquer membro.
    function canAccessList(list) {
      let gid = list.get('groupId', null);
      return (gid == null && list.ownerId == request.auth.uid)
          || (gid != null && isGroupMember(gid));
    }

    // ---------- users/{uid} ----------

    match /users/{uid} {
      // Membros precisam ler o displayName uns dos outros.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
          && validText(request.resource.data.displayName, 40)
          && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
          && request.auth.uid == uid
          && changedKeys().hasOnly(['displayName'])
          && validText(request.resource.data.displayName, 40);
    }

    // ---------- groups/{groupId} ----------

    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Quem cria nasce como único membro e admin.
      allow create: if isSignedIn()
          && request.resource.data.keys()
               .hasOnly(['name', 'createdBy', 'memberIds', 'roles', 'createdAt'])
          && validText(request.resource.data.name, 60)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.memberIds == [request.auth.uid]
          && request.resource.data.roles.keys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] == 'admin'
          && request.resource.data.createdAt == request.time;

      // Membro: renomear (admin) ou sair. Não-membro: entrar com convite.
      allow update: if isSignedIn() && (
          (request.auth.uid in resource.data.memberIds
              && (renamesGroup() || leavesGroup()))
          || joinsGroup()
      );

      // Entrar: adiciona só o próprio uid, como "member", e comprova
      // um convite válido deste grupo, consumido no mesmo lote.
      function joinsGroup() {
        let uid = request.auth.uid;
        let code = request.resource.data.joinCode;
        let invitePath = /databases/$(database)/documents/invites/$(code);
        return code is string
            && !(uid in resource.data.memberIds)
            && changedKeys().hasOnly(['memberIds', 'roles', 'joinCode'])
            && request.resource.data.memberIds
                 == resource.data.memberIds.concat([uid])
            && request.resource.data.roles.diff(resource.data.roles)
                 .affectedKeys() == [uid].toSet()
            && request.resource.data.roles[uid] == 'member'
            && get(invitePath).data.groupId == groupId
            && get(invitePath).data.expiresAt > request.time
            && getAfter(invitePath).data.uses == get(invitePath).data.uses + 1
            && (get(invitePath).data.get('maxUses', null) == null
                || getAfter(invitePath).data.uses <= get(invitePath).data.maxUses);
      }

      // Sem delete no MVP (ver "Pontos em aberto").

      // Admin muda só o nome.
      function renamesGroup() {
        return resource.data.roles[request.auth.uid] == 'admin'
            && changedKeys().hasOnly(['name'])
            && validText(request.resource.data.name, 60);
      }

      // Membro se remove de memberIds e roles, na mesma operação. Um admin pode,
      // além disso, promover UM outro membro (sucessor). Invariante final: grupo
      // vazio ou com pelo menos um admin.
      function leavesGroup() {
        let uid = request.auth.uid;
        let newData = request.resource.data;
        let rolesDiff = newData.roles.diff(resource.data.roles).affectedKeys();
        let plainLeave = rolesDiff == [uid].toSet();
        let leaveWithSuccessor = resource.data.roles[uid] == 'admin'
            && rolesDiff.size() == 2
            && rolesDiff.hasAll([uid])
            && newData.roles.keys().toSet() == newData.memberIds.toSet()
            && newData.roles.values().toSet().hasOnly(['admin', 'member']);
        return changedKeys().hasOnly(['memberIds', 'roles'])
            && newData.memberIds == resource.data.memberIds.removeAll([uid])
            && !(uid in newData.roles)
            && (plainLeave || leaveWithSuccessor)
            && (newData.memberIds.size() == 0 || 'admin' in newData.roles.values());
      }
    }

    // ---------- lists/{listId} ----------

    match /lists/{listId} {
      allow read: if isSignedIn() && canAccessList(resource.data);

      allow create: if isSignedIn()
          && request.resource.data.keys()
               .hasOnly(['name', 'groupId', 'ownerId', 'createdAt'])
          && validText(request.resource.data.name, 60)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (request.resource.data.groupId == null
              || isGroupMember(request.resource.data.groupId));

      // Nome, supermercado e data da compra podem mudar: groupId e ownerId ficam imutáveis.
      allow update: if isSignedIn()
          && canAccessList(resource.data)
          && changedKeys().hasOnly(['name', 'store', 'purchaseDate'])
          && validText(request.resource.data.name, 60)
          && validOptionalText(request.resource.data.get('store', null), 60)
          && validOptionalDate(request.resource.data.get('purchaseDate', null));

      allow delete: if isSignedIn()
          && (resource.data.ownerId == request.auth.uid
              || (resource.data.get('groupId', null) != null
                  && isGroupAdmin(resource.data.groupId)));

      // ---------- lists/{listId}/items/{itemId} ----------

      match /items/{itemId} {
        function parentList() {
          return get(/databases/$(database)/documents/lists/$(listId)).data;
        }

        allow read: if isSignedIn() && canAccessList(parentList());

        allow create: if isSignedIn()
            && canAccessList(parentList())
            && request.resource.data.keys()
                 .hasOnly(['name', 'productId', 'checked', 'addedBy', 'createdAt'])
            && validText(request.resource.data.name, 100)
            && (request.resource.data.productId == null
                || request.resource.data.productId is string)
            && request.resource.data.checked is bool
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.createdAt == request.time;

        // Marcar/desmarcar e corrigir o nome.
        allow update: if isSignedIn()
            && canAccessList(parentList())
            && changedKeys().hasOnly(['checked', 'name'])
            && request.resource.data.checked is bool
            && validText(request.resource.data.name, 100);

        allow delete: if isSignedIn() && canAccessList(parentList());
      }
    }

    // ---------- invites/{code} ----------

    match /invites/{code} {
      // get sim (o código é o segredo); list não (ninguém enumera convites).
      allow get: if isSignedIn();

      allow create: if isSignedIn()
          && code.size() >= 6 && code.size() <= 12
          && request.resource.data.keys()
               .hasOnly(['groupId', 'createdBy', 'expiresAt', 'maxUses', 'uses'])
          && isGroupMember(request.resource.data.groupId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.uses == 0
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
          && (request.resource.data.get('maxUses', null) == null
              || (request.resource.data.maxUses is int
                  && request.resource.data.maxUses > 0));

      // Consumir o convite: só o contador, +1, e só se o lote também
      // coloca quem usa dentro do grupo.
      allow update: if isSignedIn()
          && changedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1
          && resource.data.expiresAt > request.time
          && !(request.auth.uid in groupData(resource.data.groupId).memberIds)
          && request.auth.uid in
               getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId))
                 .data.memberIds;

      allow delete: if isSignedIn()
          && (resource.data.createdBy == request.auth.uid
              || isGroupAdmin(resource.data.groupId));
    }

  }
}